# Docker konteyneri DISINDAN (kabuktan) migrate/seed — 127.0.0.1 uzerinden Postgres/Redis/MinIO.
# cp .env.host.example .env.host
# pnpm db:migrate:host && pnpm db:triggers:host && pnpm db:seed:host
#
# UYARI: Bu icerigi sunucuda docker-compose `env_file: .env` olarak KULLANMA — konteyner 127.0.0.1'e
# baglanir. Sunucuda konteyner icin `.env` hostlari `postgres`, `redis`, `minio` olmali; `pnpm run ci`
# yerel `.env` dosyasini DEPLOY_REMOTE_DIR'e kopyalar.

NODE_ENV=production

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=mehmetdogandev_portfolio
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/mehmetdogandev_portfolio
STUDIO_DB_URL=postgresql://postgres:postgres@127.0.0.1:5432/mehmetdogandev_portfolio

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=redispassword123
REDIS_DB=0
REDIS_COMMAND_TIMEOUT_MS=220
REDIS_INVALIDATION_TIMEOUT_MS=8000
REDIS_LOG_INVALIDATION_MS=false
REDIS_INVALIDATION_ASYNC=false
CACHE_METRICS_ENABLED=true

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=minio
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=mehmetdogandev-uploads
S3_REGION=us-east-1

BETTER_AUTH_SECRET=lab_mehmetdogandev_change_me_openssl_rand_base64_32chars
BETTER_AUTH_URL=https://mehmetdogandev.com
NEXT_PUBLIC_BETTER_AUTH_URL=https://mehmetdogandev.com
NEXT_PUBLIC_APP_URL=https://mehmetdogandev.com
TRUSTED_ORIGINS=https://mehmetdogandev.com,https://www.mehmetdogandev.com

ADMIN_PANEL_URL=admin-panel
NEXT_PUBLIC_ADMIN_PANEL_URL=admin-panel

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@mehmetdogandev.com
SMTP_FROM_NAME="Mehmet Doğan"
SMTP_SECURE=false

DRIZZLE_GATEWAY_PASSWORD=admin123
LOG_LEVEL=info
LOG_TO_FILE=false
TRPC_MUTATION_TIMING_THRESHOLD_MS=0
