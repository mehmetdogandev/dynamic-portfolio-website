# =============================================================================
# Aksiyon Soft — üretim şablonu (.env.production.example)
# -----------------------------------------------------------------------------
# UYARI: Asagidaki Postgres/Redis/MinIO sifreleri, paylasilan LAB ortamindaki
# aksiyonsoft-webserver `.env` ile AYNI tutulmustur (ornek: postgres/postgres).
# Gercek internet uretiminde tum sifreleri degistirin. Bu dosya hassas lab
# bilgisi icerir; public repo kullanmayin.
#
# Sunucuda deploy dizininde `.env` olarak kopyalayin.
# Domainler: aksiyonsoft.com, www.aksiyonsoft.com, aksiyonsoft.com.tr,
# www.aksiyonsoft.com.tr — nginx host port 3000.
#
# App konteyneri `app-network` uzerinde; DB/Redis/S3 hostlari: postgres, redis, minio.
#
# SMTP: NODE_ENV=production iken gonderim aninda gecerli SMTP sart (lib/mail).
# Asagidaki SMTP degerleri ORNEK; mail atmadan once gercek host/kullanici/sifre yazin.
# BETTER_AUTH_SECRET: asagidaki LAB degerini uretimde `openssl rand -base64 32` ile degistirin.
#
# Docker imaj guvenligi: Dockerfile `COPY . .` ile `.env` imaja girebilir. Isterseniz
# .dockerignore icindeki `# .env` satirinin yorumunu kaldirin; o zaman build icin
# NEXT_PUBLIC_* vb. degiskenleri ayri (build-arg / secret) vermeniz gerekir.
#
# Migrate/seed kabuktan (Docker disi): `pnpm db:migrate:host` — `.env.host.example` → `.env.host`
# =============================================================================

# --- Uygulama ---
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://aksiyonsoft.com

ADMIN_PANEL_URL=admin-panel
NEXT_PUBLIC_ADMIN_PANEL_URL=admin-panel

# --- Better Auth (LAB test secret; uretimde yenileyin) ---
BETTER_AUTH_SECRET=lab_aksiyon_change_me_openssl_rand_base64_32chars
BETTER_AUTH_URL=https://aksiyonsoft.com
NEXT_PUBLIC_BETTER_AUTH_URL=https://aksiyonsoft.com
# AUTH_URL=https://aksiyonsoft.com
TRUSTED_ORIGINS=https://aksiyonsoft.com,https://www.aksiyonsoft.com,https://aksiyonsoft.com.tr,https://www.aksiyonsoft.com.tr

# --- PostgreSQL (webserver ile ayni kullanici/sifre; DB = APP_DATABASES) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aksiyon_soft
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/aksiyon_soft
STUDIO_DB_URL=postgresql://postgres:postgres@postgres:5432/aksiyon_soft

# --- Redis (webserver REDIS_PASSWORD ile ayni) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redispassword123
REDIS_DB=0
REDIS_COMMAND_TIMEOUT_MS=220
REDIS_INVALIDATION_TIMEOUT_MS=8000
REDIS_LOG_INVALIDATION_MS=false
REDIS_INVALIDATION_ASYNC=false
CACHE_METRICS_ENABLED=true

# --- MinIO / S3 (webserver MINIO_ROOT_* ile ayni) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=minio
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=aksiyon-soft-uploads
S3_REGION=us-east-1

# --- E-posta — gercek SMTP ile doldurun (ornek host calismaz) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@aksiyonsoft.com
SMTP_FROM_NAME="Aksiyon Soft"
SMTP_SECURE=false

DRIZZLE_GATEWAY_PASSWORD=admin123

BACKUP_PATH=/backup
BACKUP_RETENTION_DAYS=30
# SYSTEM_DEFAULT_CC_EMAILS=ops@aksiyonsoft.com

LOG_LEVEL=info
LOG_TO_FILE=false
TRPC_MUTATION_TIMING_THRESHOLD_MS=0

# --- pnpm run ci (export veya bu dosyada tanimlayin) ---
# DEPLOY_SSH=aksiyon2
# DEPLOY_REMOTE_DIR=/root/aksiyon-soft
# DEPLOY_IMAGE_NAME=aksiyon-soft-app
# DEPLOY_IMAGE_TAG=manuel-etiket
# COMPOSE_FILE=docker-compose.app.yml
# APP_HOST_PORT=3000
# CI_RUN_MIGRATE_BEFORE_BUILD=1
