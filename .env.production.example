# =============================================================================
# Mehmet Doğan Portfolio — üretim şablonu (.env.production.example)
# -----------------------------------------------------------------------------
# Sunucuda deploy dizininde `.env` olarak kopyalayin.
# Domain: mehmetdogandev.com, www.mehmetdogandev.com — nginx host port 3000.
#
# App konteyneri `app-network` uzerinde; DB/Redis/S3 hostlari: postgres, redis, minio.
#
# SMTP: NODE_ENV=production iken gonderim aninda gecerli SMTP sart (lib/mail).
# BETTER_AUTH_SECRET: uretimde `openssl rand -base64 32` ile degistirin.
#
# Migrate/seed kabuktan (Docker disi): `pnpm db:migrate:host` — `.env.host.example` → `.env.host`
# =============================================================================

# --- Uygulama ---
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://mehmetdogandev.com

ADMIN_PANEL_URL=admin-panel
NEXT_PUBLIC_ADMIN_PANEL_URL=admin-panel

# --- Better Auth ---
BETTER_AUTH_SECRET=lab_mehmetdogandev_change_me_openssl_rand_base64_32chars
BETTER_AUTH_URL=https://mehmetdogandev.com
NEXT_PUBLIC_BETTER_AUTH_URL=https://mehmetdogandev.com
TRUSTED_ORIGINS=https://mehmetdogandev.com,https://www.mehmetdogandev.com

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mehmetdogandev_portfolio
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/mehmetdogandev_portfolio
STUDIO_DB_URL=postgresql://postgres:postgres@postgres:5432/mehmetdogandev_portfolio

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redispassword123
REDIS_DB=0
REDIS_COMMAND_TIMEOUT_MS=220
REDIS_INVALIDATION_TIMEOUT_MS=8000
REDIS_LOG_INVALIDATION_MS=false
REDIS_INVALIDATION_ASYNC=false
CACHE_METRICS_ENABLED=true

# --- MinIO / S3 ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=minio
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=mehmetdogandev-uploads
S3_REGION=us-east-1

# --- E-posta ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@mehmetdogandev.com
SMTP_FROM_NAME="Mehmet Doğan"
SMTP_SECURE=false

DRIZZLE_GATEWAY_PASSWORD=admin123

BACKUP_PATH=/backup
BACKUP_RETENTION_DAYS=30

LOG_LEVEL=info
LOG_TO_FILE=false
TRPC_MUTATION_TIMING_THRESHOLD_MS=0

# --- pnpm run ci (export veya bu dosyada tanimlayin) ---
# DEPLOY_SSH=mehmetdogandev-server
# DEPLOY_REMOTE_DIR=/root/dynamic-portfolio-website-mehmetdogandev
# DEPLOY_IMAGE_NAME=dynamic-portfolio-website-mehmetdogandev-app
# DEPLOY_IMAGE_TAG=manuel-etiket
# COMPOSE_FILE=docker-compose.app.yml
# APP_HOST_PORT=3000
# CI_RUN_MIGRATE_BEFORE_BUILD=1
