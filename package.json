{
  "name": "dynamic-portfolio-website-mehmetdogandev",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "ci": "bash scripts/ci.sh",
    "dev": "docker compose -f docker-compose.dev.yml up -d && pnpm prepare && next dev --turbopack",
    "auth:generate": "pnpx dotenv-cli -e .env -- pnpx @better-auth/cli generate --config lib/auth/index.ts --output lib/db/schema/auth.ts",
    "cache:flush": "docker exec -it mehmetdogandev-redis redis-cli -a redispassword FLUSHALL",
    "db:generate": "npx drizzle-kit generate",
    "db:push": "npx drizzle-kit push",
    "db:migrate": "pnpx dotenv-cli -e .env -- pnpx tsx \"scripts/db-migrate-with-summary.ts\"",
    "db:migrate:host": "pnpx dotenv-cli -e .env.host -- pnpx tsx \"scripts/db-migrate-with-summary.ts\"",
    "db:baseline": "pnpx dotenv-cli -e .env -- pnpx tsx \"scripts/drizzle-baseline-stamp.ts\"",
    "db:baseline:host": "pnpx dotenv-cli -e .env.host -- pnpx tsx \"scripts/drizzle-baseline-stamp.ts\"",
    "db:seed": "pnpx dotenv-cli -e .env -- pnpx tsx \"lib/db/seed/index.ts\"",
    "db:seed:host": "pnpx dotenv-cli -e .env.host -- pnpx tsx \"lib/db/seed/index.ts\"",
    "db:triggers": "pnpx dotenv-cli -e .env -- pnpx tsx \"lib/db/seed/0_triggers.ts\"",
    "db:triggers:host": "pnpx dotenv-cli -e .env.host -- pnpx tsx \"lib/db/seed/0_triggers.ts\"",
    "db:studio": "npx drizzle-kit studio",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "prepare": "husky && next-ws patch",
    "sync-db": "node -e \"console.log('Kullanim: pnpm sync-db:ps | sync-db:cmd | sync-db:bash  (uzak: ssh aksiyon1; kok .env: POSTGRES_DB, REDIS_PASSWORD)')\"",
    "sync-db:ps": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync-db/sync-db.ps1",
    "sync-db:cmd": "cmd /c scripts\\sync-db\\sync-db.bat",
    "sync-db:bash": "bash scripts/sync-db/sync-db.sh",
    "cli": "pnpm run db:push && pnpm run db:seed && pnpm run cache:flush",
    "tl": "pnpm typecheck && pnpm lint"
  },
