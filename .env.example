# =============================================================================
# Mehmet Doğan Portfolio — localhost geliştirme ortamı (.env.example)
# -----------------------------------------------------------------------------
# Kullanım: Bu dosyayı kopyalayıp `.env` yapın; `BETTER_AUTH_SECRET` değerini
# gerçek bir secret ile değiştirin (örn. `openssl rand -base64 32`).
#
# İki yaygın senaryo:
# 1) Next.js'i doğrudan makinede çalıştırıyorsanız (`pnpm dev` / `next dev`):
#    DATABASE_URL / REDIS_HOST / S3_ENDPOINT için `localhost` kullanın (aşağıdaki gibi).
# 2) `docker-compose.local-full.yml` içindeki `nextjs` servisi:
#    Compose, DATABASE_URL ve STUDIO_DB_URL'i postgres servis adıyla override eder;
#    yine de POSTGRES_* değişkenleri compose interpolation için burada kalmalıdır.
# =============================================================================

# --- Uygulama (localhost) ---
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Kurumsal site kök yolu: boş = `/` (önerilen). Ör. `kurumsal` → `/kurumsal/hakkimda`. Admin segmentiyle aynı olmamalı.
# NEXT_PUBLIC_WEBSITE_BASE=

# Admin panel dış URL'si (örn. xxxxx → http://localhost:3000/xxxxx). İç route `app/admin-panel`; next.config rewrites eşler.
ADMIN_PANEL_URL=admin-panel
NEXT_PUBLIC_ADMIN_PANEL_URL=admin-panel

# --- Better Auth ---
# En az 32 karakter; üretim: openssl rand -base64 32
BETTER_AUTH_SECRET=__REPLACE_WITH_OPENSSL_RAND_BASE64_32__
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
# İsteğe bağlı alternatif (kod: BETTER_AUTH_URL || AUTH_URL)
# AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- PostgreSQL (docker-compose ile uyumlu isimler) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mehmetdogandev_portfolio
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Host üzerinden çalışan Next için:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mehmetdogandev_portfolio
STUDIO_DB_URL=postgresql://postgres:postgres@localhost:5432/mehmetdogandev_portfolio

# --- Redis (RBAC önbelleği) ---
# `next dev` makinede: REDIS_HOST=localhost. Redis şifresi compose ile aynı olmalı.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispassword
REDIS_DB=0
REDIS_COMMAND_TIMEOUT_MS=220
REDIS_INVALIDATION_TIMEOUT_MS=8000
REDIS_LOG_INVALIDATION_MS=false
REDIS_INVALIDATION_ASYNC=false
CACHE_METRICS_ENABLED=true

# --- MinIO / S3 (docker-compose varsayılan API portu 9000) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=mehmetdogandev-uploads
S3_REGION=us-east-1
# S3_HOST_OVERRIDE: Hostta `S3_ENDPOINT=minio` iken seed otomatik 127.0.0.1 dener; .env'e kalıcı yazmanız gerekmez.
# Next.js uygulaması bu değişkeni yok sayar (yalnızca seed/CLI için geçerli).

# --- E-posta (SMTP) ---
# Geliştirmede boş bırakılabilir (Ethereal test hesabı kullanılır).
# Gerçek SMTP: 587 genelde STARTTLS → SMTP_SECURE=false; 465 → SMTP_SECURE=true
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME="Mehmet Doğan"
SMTP_SECURE=false

# --- Drizzle Studio Gateway (tam docker-compose stack) ---
DRIZZLE_GATEWAY_PASSWORD=change-me-drizzle-gateway

# --- Yedek (manuel tetikleme, admin Jobs) ---
# Satırı silin veya boş bırakın: varsayılan os.tmpdir()/dynamic-portfolio-website-mehmetdogandev/backups.
# Göreli yol CWD'ye göre çözülür; üretimde mutlak yol önerilir.
BACKUP_PATH=./backup
BACKUP_RETENTION_DAYS=30
# SYSTEM_DEFAULT_CC_EMAILS=a@example.com,b@example.com

# Web sitesi iletişim formu — operasyon ekibine giden bildirimler (virgülle).
# Boş bırakılırsa SYSTEM_DEFAULT_CC + no-reply listesi (cc-list-builder) kullanılır.
# WEBSITE_CONTACT_RECIPIENTS=ops@example.com

# --- Portfolio site — footer & sosyal (isteğe bağlı) ---
# NEXT_PUBLIC_WEBSITE_CONTACT_EMAIL=mehmetdogan.dev@gmail.com
# NEXT_PUBLIC_WEBSITE_CONTACT_PHONE=+90 553 657 84 02
# NEXT_PUBLIC_WEBSITE_ADDRESS=Aksaray, Türkiye
# NEXT_PUBLIC_WEBSITE_SOCIAL_LINKEDIN=https://www.linkedin.com/in/mehmetdogandev
# NEXT_PUBLIC_WEBSITE_SOCIAL_GITHUB=https://github.com/mehmetdogandev
# NEXT_PUBLIC_WEBSITE_SOCIAL_X=
# NEXT_PUBLIC_WEBSITE_SOCIAL_WHATSAPP=https://wa.me/905536578402

# --- Loglama / tRPC ---
LOG_LEVEL=info
LOG_TO_FILE=false
TRPC_MUTATION_TIMING_THRESHOLD_MS=0

# --- Veritabanı ayarları (çoğu varsayılan; gerektiğinde açın) ---
# DB_LOG_POOL_CREATION=true
# DB_ENABLE_QUERY_LOGGING=true
